# URL de tu proyecto Supabase (Project Settings > Data API)
SUPABASE_URL=https://TU-PROJECT-REF.supabase.co

# Project Settings > API Keys > Secret key (sb_secret_...). Nunca lo pongas en NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=pega_aqui_tu_secret_key

# Compatibilidad con proyectos antiguos de Supabase. Usa esto solo si todavía no tienes sb_secret_.
# SUPABASE_SERVICE_ROLE_KEY=pega_aqui_tu_service_role_key

# Genera una cadena aleatoria de 32+ caracteres. También es solo del servidor.
PHOTO_SIGNING_SECRET=cambia_esto_por_una_cadena_aleatoria_de_32_o_mas_caracteres

# Auth del organizador (la clave publishable/anon sí puede estar en el navegador)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=pega_aqui_tu_publishable_key

# Solo esta cuenta podrá crear y controlar actividades.
ORGANIZER_EMAIL=tu-correo@example.com
# Opcional: segunda restricción usando el UUID de Authentication > Users.
# ORGANIZER_USER_ID=uuid-de-tu-usuario
